# Prioritize index.php over any default placeholder index.html
DirectoryIndex index.php index.html

AddHandler application/x-httpd-php82 .php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Note: Enable HTTPS redirect only after an SSL certificate is active on the server
    # RewriteCond %{HTTPS} off
    # RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
    # Modern security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Enforce HSTS for HTTPS connections
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# Block direct access to hidden files, config, databases, logs, and sensitive assets
<FilesMatch "^\.|\.(sql|env|log|md|sh|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory listings
Options -Indexes
