<IfModule mod_rewrite.c>
    RewriteEngine On

    # Enforce HTTPS in production environments (skip localhost and local IP addresses for testing)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Student web spaces. Nothing under /students/ is a real directory: the
    # files live outside the document root and are streamed by serve.php, so
    # the server never executes anything a learner saved.
    # The preview rules must stay above the published ones, or "preview"
    # would be read as a student slug.
    RewriteRule ^students/preview/([a-z0-9-]+)/?$      students/serve.php?s=$1&v=draft&f=index.html [L,QSA]
    RewriteRule ^students/preview/([a-z0-9-]+)/(.+)$   students/serve.php?s=$1&v=draft&f=$2          [L,QSA]
    RewriteRule ^students/([a-z0-9-]+)/?$              students/serve.php?s=$1&f=index.html          [L,QSA]
    RewriteRule ^students/([a-z0-9-]+)/(.+)$           students/serve.php?s=$1&f=$2                  [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    # Modern security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Enforce HSTS for HTTPS connections
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# Block direct access to hidden files, config, databases, logs, and sensitive assets
<FilesMatch "^\.|\.(sql|env|log|md|sh|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# The web app manifest needs its own media type for browsers to accept it.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# The service worker must not be served stale, or a fixed bug can stay on a
# learner's device for a day. Browsers already bypass the HTTP cache when
# checking for an update, but say so explicitly.
<Files "sw.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, max-age=0"
    </IfModule>
</Files>

# Prevent directory listings
Options -Indexes
