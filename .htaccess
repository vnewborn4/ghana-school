<IfModule mod_rewrite.c>
    RewriteEngine On

    # Enforce HTTPS in production environments (skip localhost and local IP addresses for testing)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Student web spaces. Nothing under /students/ is a real directory: the
    # files live outside the document root and are streamed by serve.php, so
    # the server never executes anything a learner saved.
    # The preview rules must stay above the published ones, or "preview"
    # would be read as a student slug.
    RewriteRule ^students/preview/([a-z0-9-]+)/?$      students/serve.php?s=$1&v=draft&f=index.html [L,QSA]
    RewriteRule ^students/preview/([a-z0-9-]+)/(.+)$   students/serve.php?s=$1&v=draft&f=$2          [L,QSA]
    RewriteRule ^students/([a-z0-9-]+)/?$              students/serve.php?s=$1&f=index.html          [L,QSA]
    RewriteRule ^students/([a-z0-9-]+)/(.+)$           students/serve.php?s=$1&f=$2                  [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    # Modern security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Enforce HSTS for HTTPS connections
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# Block direct access to hidden files, config, databases, logs, and sensitive assets
<FilesMatch "^\.|\.(sql|env|log|md|sh|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------------
# Bandwidth
#
# Most visitors are on metered mobile data in Accra. A homepage visit is about
# 105 KB, and roughly 95 KB of that is static files that do not change between
# visits. These two blocks mean a returning visitor pays for almost none of it.
# ---------------------------------------------------------------------------

# Compress text on the way out. The stylesheet alone drops from about 21 KB to
# a quarter of that.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache static files. PHP references them through asset_url(), which appends
# the file's modification time, so a new upload gets a new URL and is picked
# up straight away. The week here only applies to references without that
# stamp, which is why it is a week and not a year: nobody should be stranded
# on a stale stylesheet, and stale-while-revalidate refreshes it in the
# background rather than making anyone wait.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpe?g|png|gif|webp|svg|ico|woff2?|ttf|eot|webmanifest)$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=2592000"
    </FilesMatch>
</IfModule>

# The web app manifest needs its own media type for browsers to accept it.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# The service worker must not be served stale, or a fixed bug can stay on a
# learner's device for a day. Browsers already bypass the HTTP cache when
# checking for an update, but say so explicitly.
# Overrides the .js rule above: a service worker must never be served stale,
# or a fixed bug can sit on a learner's device for a day.
<Files "sw.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, max-age=0"
    </IfModule>
</Files>

# Prevent directory listings
Options -Indexes
